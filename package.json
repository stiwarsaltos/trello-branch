{
  "name": "trello-branch",
  "displayName": "trello-branch",
  "publisher": "stiwarsaltos-dev",
  "description": "Conecta tarjetas de Trello con ramas Git: empezar tarea, code review, commit, push y PR.",
  "version": "1.6.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/stiwarsaltos/trello-branch.git"
  },
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "trelloBranch.login",
        "title": "Trello: Iniciar sesión"
      },
      {
        "command": "trelloBranch.logout",
        "title": "Trello: Cerrar sesión"
      },
      {
        "command": "trelloBranch.githubLogin",
        "title": "GitHub: Iniciar sesión"
      },
      {
        "command": "trelloBranch.githubLogout",
        "title": "GitHub: Cerrar sesión"
      },
      {
        "command": "trelloBranch.startTask",
        "title": "Trello: Empezar tarea"
      },
      {
        "command": "trelloBranch.finishTask",
        "title": "Trello: Terminar tarea"
      },
      {
        "command": "trelloBranch.returnTask",
        "title": "Trello: Regresar tarea"
      },
      {
        "command": "trelloBranch.copyCardText",
        "title": "Trello: Copiar texto de tarjeta"
      },
      {
        "command": "trelloBranch.previewCardImage",
        "title": "Trello: Previsualizar imagen"
      },
      {
        "command": "trelloBranch.addBoard",
        "title": "Trello: Agregar tablero"
      },
      {
        "command": "trelloBranch.setCompanionRepo",
        "title": "Trello: Configurar repo companion"
      },
      {
        "command": "trelloBranch.clearCompanionRepo",
        "title": "Trello: Quitar repo companion"
      },
      {
        "command": "trelloBranch.showLog",
        "title": "Trello: Ver registro"
      },
      {
        "command": "trelloBranch.refreshView",
        "title": "Trello: Actualizar vista",
        "icon": "$(refresh)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "trelloBranch",
          "title": "Trello Branch",
          "icon": "resources/trello.svg"
        }
      ]
    },
    "views": {
      "trelloBranch": [
        {
          "id": "trelloBranch.tasks",
          "name": "Tareas"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "trelloBranch.addBoard",
          "when": "view == trelloBranch.tasks",
          "group": "navigation@1"
        },
        {
          "command": "trelloBranch.refreshView",
          "when": "view == trelloBranch.tasks",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "Trello Branch",
      "properties": {
        "trelloBranch.developerName": {
          "type": "string",
          "description": "Prefijo de la rama. Si está vacío, se usa el primer nombre del perfil de Trello."
        },
        "trelloBranch.baseBranch": {
          "type": "string",
          "default": "develop",
          "description": "Rama base desde la que se crea la nueva rama"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/lz-string": "^1.3.34",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.125.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "axios": "^1.19.0",
    "lz-string": "^1.5.0",
    "simple-git": "^3.36.0"
  }
}
